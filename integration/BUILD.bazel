load("@aspect_rules_js//js:defs.bzl", "js_test")

# Fast integration tests — tooling layer, no Claude API calls or cheap calls
[js_test(
    name = test_file.replace(".test.cjs", ""),
    entry_point = test_file,
    data = [
        "//integration/helpers:test_helpers",
    ],
    size = "large",
    tags = ["integration", "local"],
    timeout = "long",
) for test_file in [
    "fork-preservation.test.cjs",
    "gsd-tools-workflow.test.cjs",
    "multi-user-resolution.test.cjs",
]]

# Moderate integration tests — individual skill execution, real API calls
[js_test(
    name = test_file.replace(".test.cjs", ""),
    entry_point = test_file,
    data = [
        "//integration/helpers:test_helpers",
    ],
    size = "large",
    tags = ["integration", "local", "requires-api-key"],
    timeout = "long",
) for test_file in [
    "skill-execution.test.cjs",
]]

# Phase 2 critic refactor — spike pair: positive + inverse (B2/O5, 02-REVIEWS.md).
# Inverse test eliminates the false-positive PASS surface for the canary spike.
# Both targets carry the phase-2-critic Bazel tag so
#   bazel query 'attr(tags, "phase-2-critic", //integration/...)'
# lists critic-spike-passes AND critic-spike-inverse together.
[js_test(
    name = test_file.replace(".test.cjs", ""),
    entry_point = test_file,
    data = ["//integration/helpers:test_helpers"],
    size = "large",
    tags = ["integration", "local", "requires-api-key", "phase-2-critic"],
    timeout = "long",
) for test_file in [
    "critic-spike-passes.test.cjs",
    "critic-spike-inverse.test.cjs",
]]

# Phase 2 critic batch — live tests (CRIT-08 walltime, CRIT-09 fault-injection)
# added Plan 02-07. Both consume the test-managed fixture phase directory at
# integration/test-fixtures/fixture-phase-2-critic/ (B7 fix per 02-REVIEWS.md).
[js_test(
    name = test_file.replace(".test.cjs", ""),
    entry_point = test_file,
    data = ["//integration/helpers:test_helpers"] + glob(["test-fixtures/fixture-phase-2-critic/*.md"]),
    size = "large",
    tags = ["integration", "local", "requires-api-key", "phase-2-critic"],
    timeout = "long",
) for test_file in [
    "critic-batch-walltime.test.cjs",
    "critic-fault-injection.test.cjs",
]]

# Phase 2 CRIT-10 parity — expensive (~$25, ~30min); nightly + phase-exit only.
js_test(
    name = "critic-parity",
    entry_point = "critic-parity.test.cjs",
    data = ["//integration/helpers:test_helpers"] + glob(["test-fixtures/baselines/critic-*/*"]),
    size = "enormous",
    tags = ["integration", "local", "requires-api-key", "phase-2-critic", "nightly"],
    timeout = "eternal",
)

load("@aspect_rules_js//js:defs.bzl", "js_library")

js_library(
    name = "lifecycle_steps",
    srcs = glob(["lifecycle-steps/*.cjs"]),
    data = glob(["test-fixtures/lifecycle-shapes/*.json"]),
)

# Plan 02-11: expose the live walltime ledger so static schema tests
# (e.g. //tests:walltime-ledger-schema) can read the committed snapshot
# inside the bazel sandbox. Uses js_library (not filegroup) so
# aspect_rules_js will copy the data file into the sandbox for sibling-
# package consumers.
js_library(
    name = "walltime-ledger",
    srcs = ["test-fixtures/walltime-ledger.jsonl"],
    visibility = ["//tests:__pkg__"],
)

# Lifecycle pipeline — full GSD lifecycle, expensive, long-running
js_test(
    name = "gsd-lifecycle",
    entry_point = "gsd-lifecycle.test.cjs",
    data = [
        ":lifecycle_steps",
        "//integration/helpers:test_helpers",
    ],
    size = "enormous",
    tags = ["integration", "local", "requires-api-key", "lifecycle", "phase-1-cull", "phase-2-critic"],
    timeout = "eternal",
)
