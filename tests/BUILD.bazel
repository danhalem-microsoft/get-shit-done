load("@aspect_rules_js//js:defs.bzl", "js_test")

# Static unit tests over integration/helpers/. No live API, no shared state
# mutation — each test uses local-scope vars and (where applicable) a temp
# ledger path. Pattern mirrors integration/BUILD.bazel's "fast integration
# tests" block.
[js_test(
    name = test_file.replace(".test.cjs", ""),
    entry_point = test_file,
    data = [
        "//integration/helpers:test_helpers",
    ],
    size = "small",
    tags = ["unit", "local", "phase-1-cull"],
    timeout = "short",
) for test_file in [
    "agent-parity-helper-shape.test.cjs",
    "walltime-recorder.test.cjs",
    "gsd-tools-dispatcher-reachable.test.cjs",
]]

# Phase 2 critic refactor — static tests (added Phase 2 Wave 0).
# Plans 03 and 06 will EXTEND this list-comprehension with their own static
# tests. Spike + inverse spike live in integration/BUILD.bazel (B8 — no
# cross-directory entry_point).
[js_test(
    name = test_file.replace(".test.cjs", ""),
    entry_point = test_file,
    data = ["//integration/helpers:test_helpers"],
    size = "small",
    tags = ["unit", "local", "phase-2-critic"],
    timeout = "short",
) for test_file in [
    "critic-line-budget.test.cjs",
    "critic-no-base-shadowing.test.cjs",
    "critic-findings-delta-shape.test.cjs",
    "install-shared-dir.test.cjs",
    "walltime-ledger-schema.test.cjs",
    "critic-aggregate-shape.test.cjs",
    "critique-workflow-structure.test.cjs",
]]

# Phase 2 gap-closure additions (Plan 02-10): test files existed on disk but
# had no BUILD entries, so `--test_tag_filters=phase-2-critic` undercounted
# coverage. `cull-no-orphan-references` is dual-tagged (phase-1-cull AND
# phase-2-critic) — it locks the Phase 1 cull AND was extended in Plan 02-03
# to cover `agents/_shared/`. The `gsd-sdk-query-registry-integration` test
# drift-guards the Plan 02-06 critic-aggregate handler registration.
# `data` attribute is intentionally minimal here; Plan 02-11 broadens it.
js_test(
    name = "cull-no-orphan-references",
    entry_point = "cull-no-orphan-references.test.cjs",
    data = [
        "//integration/helpers:test_helpers",
        "fixtures/cull-deletion-list.cjs",
        "//:project_sources",
    ],
    size = "medium",
    tags = ["unit", "local", "phase-1-cull", "phase-2-critic"],
    timeout = "short",
)

js_test(
    name = "gsd-sdk-query-registry-integration",
    entry_point = "gsd-sdk-query-registry-integration.test.cjs",
    data = [
        "//integration/helpers:test_helpers",
        "//:project_sources",
    ],
    size = "small",
    tags = ["unit", "local", "phase-2-critic"],
    timeout = "short",
)
